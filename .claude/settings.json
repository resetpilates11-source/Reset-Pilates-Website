{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run preview:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(bun test:*)",
      "Bash(bun run test:*)",
      "Bash(bun run build:*)",
      "Bash(bun run dev:*)",
      "Bash(bun run preview:*)",
      "Bash(bun install:*)",
      "Bash(npx tsc:*)",
      "Bash(bunx tsc:*)",
      "Bash(npx vite build:*)",
      "Bash(bunx vite build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Bash(wrangler deploy:*)",
      "Bash(wrangler publish:*)",
      "Bash(wrangler secret:*)",
      "Bash(wrangler delete:*)",
      "Bash(wrangler rollback:*)",
      "Bash(wrangler versions:*)",
      "Bash(wrangler pages:*)",
      "Bash(wrangler d1:*)",
      "Bash(wrangler kv:*)",
      "Bash(wrangler r2:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler publish:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npx wrangler delete:*)",
      "Bash(npx wrangler rollback:*)",
      "Bash(npx wrangler versions:*)",
      "Bash(npx wrangler pages:*)",
      "Bash(npx wrangler d1:*)",
      "Bash(npx wrangler kv:*)",
      "Bash(npx wrangler r2:*)",
      "Bash(bunx wrangler deploy:*)",
      "Bash(bunx wrangler publish:*)",
      "Bash(bunx wrangler secret:*)",
      "Bash(bunx wrangler delete:*)",
      "Bash(bunx wrangler rollback:*)",
      "Bash(bunx wrangler versions:*)",
      "Bash(bunx wrangler pages:*)",
      "Bash(bunx wrangler d1:*)",
      "Bash(bunx wrangler kv:*)",
      "Bash(bunx wrangler r2:*)",
      "Bash(npm run deploy:*)",
      "Bash(bun run deploy:*)",
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)"
    ]
  }
}
