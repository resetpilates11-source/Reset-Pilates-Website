{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run build)",
      "Bash(bun run test)",
      "Bash(bun run test:*)",
      "Bash(bun run lint)",
      "Bash(bun run typecheck)",
      "Bash(bun test)",
      "Bash(bun test:*)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx tsc -p worker)",
      "Bash(bunx wrangler whoami)",
      "Bash(bunx wrangler types)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler publish*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler versions upload*)",
      "Bash(*wrangler pages deploy*)",
      "Bash(*wrangler secret*)",
      "Bash(*wrangler delete*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler d1 execute*)",
      "Bash(*wrangler d1 migrations apply*)",
      "Bash(*wrangler kv*)",
      "Bash(*wrangler r2*)",
      "Bash(bun run deploy*)",
      "Bash(npm run deploy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(rm -rf*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)"
    ]
  }
}
